{
  "name": "aulia-care",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @aulia-care/frontend\" \"npm run dev -w @aulia-care/backend\"",

    "dev:frontend": "npm run dev -w @aulia-care/frontend",
    "dev:backend": "npm run dev -w @aulia-care/backend",

    "dev:clinical-ai": "npm run dev:clinical-ai -w @aulia-care/backend",
    "dev:connected-care": "npm run dev:connected-care -w @aulia-care/backend",

    "build": "npm run build -w @aulia-care/frontend && npm run build -w @aulia-care/backend",

    "build:frontend": "npm run build -w @aulia-care/frontend",
    "build:backend": "npm run build -w @aulia-care/backend",

    "start": "npm run start -w @aulia-care/backend",
    "start:prod": "npm run start:prod -w @aulia-care/backend",

    "start:clinical-ai": "npm run start:clinical-ai -w @aulia-care/backend",
    "start:connected-care": "npm run start:connected-care -w @aulia-care/backend",

    "lint": "npm run lint --workspaces --if-present",

    "typecheck": "npm run typecheck --workspaces --if-present",

    "test": "npm run test --workspaces --if-present",

    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration -w @aulia-care/backend",
    "test:e2e": "npm run test:e2e -w @aulia-care/backend",

    "prisma:generate": "npm run prisma:generate -w @aulia-care/backend",
    "prisma:studio": "npm run prisma:studio -w @aulia-care/backend",
    "prisma:migrate:dev": "npm run prisma:migrate:dev -w @aulia-care/backend",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w @aulia-care/backend",
    "prisma:db:push": "npm run prisma:db:push -w @aulia-care/backend",
    "db:seed": "npm run db:seed -w @aulia-care/backend",

    "bootstrap:dev": "npm run bootstrap:dev -w @aulia-care/backend",

    "maintenance:backfill-single-clinic-staff": "npm run maintenance:backfill-single-clinic-staff -w @aulia-care/backend",
    "maintenance:security-retention": "npm run maintenance:security-retention -w @aulia-care/backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}