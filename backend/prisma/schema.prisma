generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Roles, permissions and users.
model Role {
  id          String           @id @default(uuid())
  slug        RoleSlug         @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  syncedAt    DateTime?
  sourceNode  String?
  version     Int              @default(1)
  permissions RolePermission[]
  userRoles   UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  action      PermissionAction
  resource    String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  syncedAt    DateTime?
  sourceNode  String?
  version     Int              @default(1)
  roles       RolePermission[]

  @@unique([action, resource])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  syncedAt     DateTime?
  sourceNode   String?
  version      Int        @default(1)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id                               String                           @id @default(uuid())
  email                            String                           @unique
  username                         String                           @unique
  displayName                      String
  firstName                        String
  lastName                         String
  passwordHash                     String
  status                           UserStatus                       @default(ACTIVE)
  primaryRole                      RoleSlug?
  specialty                        String?
  bio                              String?
  profilePhotoUrl                  String?
  phone                            String?
  whatsappUrl                      String?
  facebookUrl                      String?
  instagramUrl                     String?
  linkedinUrl                      String?
  nationality                      String?
  addressCountry                   String?
  addressProvince                  String?
  addressCity                      String?
  addressNeighborhood              String?
  addressStreet                    String?
  lastLoginAt                      DateTime?
  preferredLanguage                String?                          @default("fr")
  createdAt                        DateTime                         @default(now())
  updatedAt                        DateTime                         @updatedAt
  deletedAt                        DateTime?
  syncedAt                         DateTime?
  sourceNode                       String?
  version                          Int                              @default(1)
  clinicId                         String?
  Allergy                          Allergy[]
  appointmentsRequested            Appointment[]                    @relation("AppointmentRequester")
  auditLogs                        AuditLog[]
  AuditTrail                       AuditTrail[]
  receivedChatMessages             ChatMessage[]                    @relation("ChatMessageRecipient")
  sentChatMessages                 ChatMessage[]                    @relation("ChatMessageSender")
  ClinicalCondition                ClinicalCondition[]
  providedConsultations            Consultation[]                   @relation("ConsultationProvider")
  consultationNotesAuthored        ConsultationNote[]               @relation("ConsultationNoteAuthor")
  departmentResponsibilities       DepartmentResponsable[]
  Diagnosis                        Diagnosis[]
  emergencyLocationRequests        EmergencyLocationRequest[]       @relation("EmergencyLocationRequester")
  Employee                         Employee[]
  GoodsReceipt                     GoodsReceipt[]
  hospitalizationsAsNurse          Hospitalization[]                @relation("HospitalizationNurse")
  hospitalizationsAsPhysician      Hospitalization[]                @relation("HospitalizationPhysician")
  hospitalizationNurseAssignments  HospitalizationNurseAssignment[]
  imagingReportsInterpreted        ImagingReport[]                  @relation("ImagingReportInterpreter")
  imagingReportsRadiologist        ImagingReport[]                  @relation("ImagingReportRadiologist")
  imagingRequestsRequested         ImagingRequest[]                 @relation("ImagingRequestRequester")
  imagingRequestsTechnician        ImagingRequest[]                 @relation("ImagingRequestTechnician")
  InsuranceAuthorization           InsuranceAuthorization[]
  InsuranceClaim                   InsuranceClaim[]
  invoicesIssued                   Invoice[]                        @relation("InvoiceIssuer")
  requestedInvoiceDiscounts        InvoiceDiscountRequest[]         @relation("InvoiceDiscountRequester")
  reviewedInvoiceDiscounts         InvoiceDiscountRequest[]         @relation("InvoiceDiscountReviewer")
  labConsumableStockUpdates        LabConsumableStock[]             @relation("LabConsumableStockUpdatedBy")
  labConsumableTransactions        LabConsumableTransaction[]       @relation("LabConsumableTransactionPerformedBy")
  labCriticalAlertsAcknowledged    LabCriticalAlert[]               @relation("LabCriticalAlertAcknowledger")
  labReportsIssued                 LabReport[]                      @relation("LabReportIssuedBy")
  labRequestsRequested             LabRequest[]                     @relation("LabRequestRequester")
  labRequestEventsPerformed        LabRequestEvent[]                @relation("LabRequestEventPerformedBy")
  labRequestItemsAssigned          LabRequestItem[]                 @relation("LabRequestItemAssignedTo")
  labResultBiologicalValidated     LabResult[]                      @relation("LabResultBiologicalValidator")
  labResultsReported               LabResult[]                      @relation("LabResultReporter")
  labResultTechnicalValidated      LabResult[]                      @relation("LabResultTechnicalValidator")
  labResultParametersReported      LabResultParameter[]             @relation("LabResultParameterReporter")
  labSamplesCollected              LabSample[]                      @relation("LabSampleCollectedBy")
  labSampleTrackingEventsPerformed LabSampleTrackingEvent[]         @relation("LabSampleTrackingPerformedBy")
  labSectionStaff                  LabSectionStaff[]
  labTestsCreated                  LabTest[]                        @relation("LabTestCreatedBy")
  labTestsUpdated                  LabTest[]                        @relation("LabTestUpdatedBy")
  LeaveRequest                     LeaveRequest[]
  LoginAttempt                     LoginAttempt[]
  medicalHistoriesCreated          MedicalHistory[]                 @relation("MedicalHistoryCreatedBy")
  notificationsSent                Notification[]                   @relation("NotificationAuthor")
  notifications                    Notification[]                   @relation("NotificationRecipient")
  parentChildLinks                 ParentChildLink[]                @relation("ParentUser")
  patientPortalProfile             Patient?                         @relation("PatientPortalUser")
  telehealthSessionsAsDoctor       TelehealthSession[]              @relation("TelehealthSessionDoctor")
  telehealthSessionsAsPatient      TelehealthSession[]              @relation("TelehealthSessionPatientUser")
  wearableLotsReceived             WearableLot[]                    @relation("WearableLotReceivedBy")
  nursingCareTasksAssigned         NursingCareTask[]                @relation("NursingCareTaskAssignedNurse")
  medicationAdministrations        MedicationAdministration[]       @relation("MedicationAdministrationNurse")
  PasswordHistory                  PasswordHistory[]
  PasswordResetToken               PasswordResetToken[]
  registeredPatients               Patient[]                        @relation("PatientReceptionist")
  receptionPatientVisits           PatientVisit[]                   @relation("ReceptionPatientVisits")
  paymentsMade                     Payment[]                        @relation("PaymentPayer")
  Payroll                          Payroll[]
  pharmacyDispenses                PharmacyDispense[]               @relation("PharmacyDispenseDispenser")
  prescriptionsPrescribed          Prescription[]                   @relation("PrescriptionPrescriber")
  ProblemList                      ProblemList[]
  refreshTokens                    RefreshToken[]
  serviceResponsabilites           ServiceResponsable[]
  staff                            ServiceStaff[]
  Session                          Session[]
  StockTransaction                 StockTransaction[]
  surgeriesAsAnesthesiologist      Surgery[]                        @relation("SurgeryAnesthesiologist")
  surgeriesAsSurgeon               Surgery[]                        @relation("SurgerySurgeon")
  clinic                           Clinic?                          @relation(fields: [clinicId], references: [id])
  roles                            UserRole[]
  Vaccination                      Vaccination[]
  vitalSignsRecorded               VitalSign[]                      @relation("VitalSignRecordedBy")

  @@index([primaryRole])
  @@index([clinicId])
}

model UserRole {
  id         String    @id @default(uuid())
  userId     String
  roleId     String
  active     Boolean   @default(true)
  assignedAt DateTime  @default(now())
  syncedAt   DateTime?
  sourceNode String?
  version    Int       @default(1)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Department {
  id                        String                  @id @default(uuid())
  name                      String                  @unique
  type                      DepartmentType
  code                      String                  @unique
  description               String?
  isParamedical             Boolean                 @default(false)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  deletedAt                 DateTime?
  syncedAt                  DateTime?
  sourceNode                String?
  version                   Int                     @default(1)
  clinicId                  String?
  clinic                    Clinic?                 @relation(fields: [clinicId], references: [id])
  departmentResponsabilites DepartmentResponsable[]
  Employee                  Employee[]
  services                  ServiceUnit[]

  @@index([clinicId])
}

model ServiceUnit {
  id               String            @id @default(uuid())
  name             String
  departmentId     String
  clinicId         String?
  location         String?
  contactNumber    String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  syncedAt         DateTime?
  sourceNode       String?
  version          Int               @default(1)
  appointments     Appointment[]
  Employee         Employee[]
  hospitalizations Hospitalization[]
  rooms            Room[]
  clinic           Clinic?           @relation(fields: [clinicId], references: [id])
  department       Department        @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, name])
  @@index([clinicId])
}

/// Central services catalog (e.g. Cardiologie, Radiologie)
model Service {
  id                  String               @id @default(uuid())
  name                String               @unique
  description         String?
  active              Boolean              @default(true)
  isParamedical       Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  syncedAt            DateTime?
  sourceNode          String?
  version             Int                  @default(1)
  clinicId            String?
  patients            Patient[]
  patientVisits       PatientVisit[]
  clinic              Clinic?              @relation(fields: [clinicId], references: [id])
  responsables        ServiceResponsable[]
  staff               ServiceStaff[]
  tarifs              ServiceTarif[]
  subscriptionCharges SubscriptionCharge[]

  @@index([clinicId])
}

/// DepartmentResponsable links departments to users (department chiefs)
model DepartmentResponsable {
  id           String     @id @default(uuid())
  departmentId String
  userId       String
  principal    Boolean    @default(false)
  actif        Boolean    @default(true)
  createdAt    DateTime   @default(now())
  syncedAt     DateTime?
  sourceNode   String?
  version      Int        @default(1)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([departmentId])
}

/// ServiceTarif allows historisation of service prices
model ServiceTarif {
  id         String    @id @default(uuid())
  serviceId  String
  prix       Decimal   @db.Decimal(12, 2)
  dateDebut  DateTime  @default(now())
  dateFin    DateTime?
  actif      Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  syncedAt   DateTime?
  sourceNode String?
  version    Int       @default(1)
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model AdmissionFee {
  id         String    @id @default(uuid())
  label      String    @default("Frais de fiche d'admission")
  amount     Decimal   @db.Decimal(12, 2)
  currency   String    @default("CDF")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  syncedAt   DateTime?
  sourceNode String?
  version    Int       @default(1)
}

model ServiceStaff {
  id            String    @id @default(uuid())
  serviceId     String
  userId        String
  roleInService String?
  actif         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  syncedAt      DateTime?
  sourceNode    String?
  version       Int       @default(1)
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceId, userId])
}

/// ServiceResponsable links services to users (physicians)
model ServiceResponsable {
  id         String    @id @default(uuid())
  serviceId  String
  userId     String
  principal  Boolean   @default(false)
  actif      Boolean   @default(true)
  createdAt  DateTime  @default(now())
  syncedAt   DateTime?
  sourceNode String?
  version    Int       @default(1)
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Patients and clinical records.
model Patient {
  id                     String                     @id @default(uuid())
  firstName              String
  lastName               String
  middleName             String?
  gender                 String
  profession             String?
  dateOfBirth            DateTime
  externalId             String?                    @unique
  phone                  String?
  email                  String?                    @unique
  address                String?
  city                   String?
  postalCode             String?
  nationality            String?
  bloodType              String?
  emergencyContact       String?
  emergencyPhone         String?
  insuranceProvider      String?
  insuranceNumber        String?
  status                 String                     @default("ACTIVE")
  workflowStatus         PatientWorkflowStatus      @default(EN_ATTENTE_DE_PAIEMENT)
  admissionType          String?
  priority               String?
  arrivalAt              DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  deletedAt              DateTime?
  receptionistId         String?
  serviceId              String?
  syncedAt               DateTime?
  sourceNode             String?
  version                Int                        @default(1)
  clinicId               String?
  portalUserId           String?                    @unique
  Allergy                Allergy[]
  appointments           Appointment[]
  auditLogs              AuditLog[]
  ClinicalCondition      ClinicalCondition[]
  consultations          Consultation[]
  Diagnosis              Diagnosis[]
  emergencyLocations     EmergencyLocation[]
  locationRequests       EmergencyLocationRequest[]
  hospitalizations       Hospitalization[]
  imagingRequests        ImagingRequest[]
  InsuranceAuthorization InsuranceAuthorization[]
  InsuranceClaim         InsuranceClaim[]
  InsurancePolicy        InsurancePolicy[]
  invoices               Invoice[]
  labCriticalAlerts      LabCriticalAlert[]
  labRequests            LabRequest[]
  medicalHistories       MedicalHistory[]
  notifications          Notification[]
  paramedicalVouchers    ParamedicalVoucher?
  childLinks             ParentChildLink[]          @relation("ChildPatient")
  portalUser             User?                      @relation("PatientPortalUser", fields: [portalUserId], references: [id], onDelete: SetNull)
  clinic                 Clinic?                    @relation(fields: [clinicId], references: [id])
  receptionist           User?                      @relation("PatientReceptionist", fields: [receptionistId], references: [id])
  service                Service?                   @relation(fields: [serviceId], references: [id])
  familyContacts         PatientContact[]
  visits                 PatientVisit[]
  prescriptions          Prescription[]
  ProblemList            ProblemList[]
  subscriptionCharges    SubscriptionCharge[]
  subscriptionEmployees  SubscriptionEmployee[]
  surgeries              Surgery[]
  Vaccination            Vaccination[]
  vitalSigns             VitalSign[]
  wearableDevices        WearableDevice[]
  wearableMeasurements   WearableMeasurement[]
  wearableSubscriptions  WearableSubscription[]
  telehealthSessions     TelehealthSession[]

  @@index([lastName, firstName])
  @@index([dateOfBirth])
  @@index([clinicId])
}

model PatientContact {
  id           String    @id @default(uuid())
  patientId    String
  name         String
  relationship String?
  phone        String?
  email        String?
  address      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  syncedAt     DateTime?
  sourceNode   String?
  version      Int       @default(1)
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

/// Immutable trace of each passage through reception. It is intentionally
/// separate from the longitudinal patient record.
model PatientVisit {
  id                 String             @id @default(uuid())
  patientId          String
  receptionistId     String?
  clinicId           String?
  appointmentId      String?            @unique
  invoiceId          String?            @unique
  serviceId          String?
  visitType          String
  reason             String?
  status             PatientVisitStatus @default(REGISTERED)
  arrivedAt          DateTime           @default(now())
  orientedAt         DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  appointment        Appointment?       @relation("AppointmentPatientVisit", fields: [appointmentId], references: [id])
  clinic             Clinic?            @relation(fields: [clinicId], references: [id])
  invoice            Invoice?           @relation("InvoicePatientVisit", fields: [invoiceId], references: [id])
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  receptionist       User?              @relation("ReceptionPatientVisits", fields: [receptionistId], references: [id])
  service            Service?           @relation(fields: [serviceId], references: [id])

  @@index([patientId, arrivedAt])
  @@index([receptionistId, arrivedAt])
  @@index([clinicId, arrivedAt])
  @@index([status, arrivedAt])
}

/// Wear OS and watchOS devices may transmit while their eSIM connection is active.
/// Authentication secrets must be stored outside this table (in the secret manager).
model WearableDevice {
  id                 String                     @id @default(uuid())
  patientId          String
  manufacturer       WearableManufacturer
  platform           WearablePlatform
  externalDeviceId   String                     @unique
  inventoryDeviceId  String?                    @unique
  displayName        String?
  esimPhoneNumber    String?
  status             WearableStatus             @default(ACTIVE)
  pairedAt           DateTime                   @default(now())
  lastSeenAt         DateTime?
  lastLocationAt     DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  revokedAt          DateTime?
  emergencyLocations EmergencyLocation[]
  locationRequests   EmergencyLocationRequest[]
  patient            Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  inventoryDevice    WearableInventoryDevice?   @relation(fields: [inventoryDeviceId], references: [id])
  measurements       WearableMeasurement[]
  subscriptions      WearableSubscription[]

  @@index([patientId, status])
  @@index([lastSeenAt])
}

/// A monthly commercial plan is defined by administration. Prices are never accepted
/// from patient, staff or watch clients.
model WearablePlan {
  id            String                 @id @default(uuid())
  manufacturer  WearableManufacturer   @unique
  monthlyPrice  Decimal                @db.Decimal(12, 2)
  currency      String                 @default("CDF")
  active        Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  lots          WearableLot[]
  subscriptions WearableSubscription[]
}

/// Aulia-owned inventory. Only a serial registered in a lot can ever be assigned.
model WearableLot {
  id           String                    @id @default(uuid())
  reference    String                    @unique
  manufacturer WearableManufacturer
  receivedAt   DateTime                  @default(now())
  receivedById String?
  note         String?
  paidAmount   Decimal?                  @db.Decimal(12, 2)
  currency     String                    @default("CDF")
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  planId       String?
  plan         WearablePlan?             @relation(fields: [planId], references: [id])
  devices      WearableInventoryDevice[]
  receivedBy   User?                     @relation("WearableLotReceivedBy", fields: [receivedById], references: [id])

  @@index([manufacturer, receivedAt])
}

model WearableInventoryDevice {
  id             String                  @id @default(uuid())
  lotId          String
  serialNumber   String                  @unique
  hardwareKeyId  String                  @unique
  platform       WearablePlatform
  status         WearableInventoryStatus @default(AVAILABLE)
  provisionedAt  DateTime?
  assignedAt     DateTime?
  returnedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  lot            WearableLot             @relation(fields: [lotId], references: [id], onDelete: Restrict)
  wearableDevice WearableDevice?
  subscriptions  WearableSubscription[]

  @@index([status, lotId])
}

/// Subscription history is append-only. An overdue subscription suspends the linked
/// WearableDevice automatically; it is never reactivated by a client request.
model WearableSubscription {
  id                String                     @id @default(uuid())
  patientId         String
  wearableDeviceId  String
  inventoryDeviceId String
  planId            String
  status            WearableSubscriptionStatus @default(PENDING_PAYMENT)
  amount            Decimal                    @db.Decimal(12, 2)
  currency          String                     @default("CDF")
  periodStartAt     DateTime
  periodEndAt       DateTime
  paidAt            DateTime?
  invoiceId         String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  patient           Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  wearableDevice    WearableDevice             @relation(fields: [wearableDeviceId], references: [id], onDelete: Cascade)
  inventoryDevice   WearableInventoryDevice    @relation(fields: [inventoryDeviceId], references: [id])
  plan              WearablePlan               @relation(fields: [planId], references: [id])
  invoice           Invoice?                   @relation(fields: [invoiceId], references: [id])

  @@index([patientId, status, periodEndAt])
  @@index([wearableDeviceId, periodEndAt])
}

/// This table can be converted to a TimescaleDB hypertable using TIMESCALEDB.md.
/// One row represents one normalized vital-sign sample; no clinical interpretation is stored here.
model WearableMeasurement {
  id               String             @id @default(uuid())
  wearableDeviceId String
  patientId        String
  metric           WearableMetric
  value            Decimal            @db.Decimal(12, 4)
  unit             String
  measuredAt       DateTime
  receivedAt       DateTime           @default(now())
  sourceSequence   String             @default("")
  quality          MeasurementQuality @default(UNKNOWN)
  metadata         Json?
  patient          Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  wearableDevice   WearableDevice     @relation(fields: [wearableDeviceId], references: [id], onDelete: Cascade)

  @@unique([wearableDeviceId, metric, measuredAt, sourceSequence])
  @@index([patientId, metric, measuredAt])
  @@index([wearableDeviceId, measuredAt])
  @@index([measuredAt])
}

/// Auditable GPS fixes collected only after an explicit emergency request or a critical alert.
model EmergencyLocation {
  id               String                    @id @default(uuid())
  patientId        String
  wearableDeviceId String?
  requestId        String?
  latitude         Decimal                   @db.Decimal(9, 6)
  longitude        Decimal                   @db.Decimal(9, 6)
  accuracyMeters   Decimal?                  @db.Decimal(10, 2)
  altitudeMeters   Decimal?                  @db.Decimal(10, 2)
  capturedAt       DateTime
  receivedAt       DateTime                  @default(now())
  source           LocationSource
  patient          Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  request          EmergencyLocationRequest? @relation(fields: [requestId], references: [id])
  wearableDevice   WearableDevice?           @relation(fields: [wearableDeviceId], references: [id])

  @@index([patientId, capturedAt])
  @@index([wearableDeviceId, capturedAt])
  @@index([requestId])
}

/// A request causes the server to send a silent push command; the watch still enforces OS consent.
model EmergencyLocationRequest {
  id               String                         @id @default(uuid())
  patientId        String
  wearableDeviceId String?
  requestedById    String?
  reason           EmergencyLocationReason
  status           EmergencyLocationRequestStatus @default(PENDING)
  requestedAt      DateTime                       @default(now())
  expiresAt        DateTime
  fulfilledAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  locations        EmergencyLocation[]
  patient          Patient                        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedBy      User?                          @relation("EmergencyLocationRequester", fields: [requestedById], references: [id])
  wearableDevice   WearableDevice?                @relation(fields: [wearableDeviceId], references: [id])

  @@index([wearableDeviceId, status])
  @@index([status, expiresAt])
}

/// A parent account can obtain a limited link to a child patient record.
/// Only a hash of the QR/token is persisted; raw tokens must never be stored.
model ParentChildLink {
  id             String                @id @default(uuid())
  parentUserId   String
  childPatientId String
  tokenHash      String                @unique
  status         ParentChildLinkStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  child          Patient               @relation("ChildPatient", fields: [childPatientId], references: [id], onDelete: Cascade)
  parent         User                  @relation("ParentUser", fields: [parentUserId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, childPatientId])
  @@index([childPatientId, status])
  @@index([status, expiresAt])
}

model Room {
  id            String      @id @default(uuid())
  number        String      @unique
  serviceUnitId String
  status        RoomStatus  @default(AVAILABLE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  syncedAt      DateTime?
  sourceNode    String?
  version       Int         @default(1)
  beds          Bed[]
  serviceUnit   ServiceUnit @relation(fields: [serviceUnitId], references: [id])
}

model Bed {
  id                String           @id @default(uuid())
  roomId            String
  code              String
  status            BedStatus        @default(FREE)
  hospitalizationId String?          @unique
  createdAt         DateTime         @default(now())
  syncedAt          DateTime?
  sourceNode        String?
  version           Int              @default(1)
  hospitalization   Hospitalization? @relation("HospitalizationBed", fields: [hospitalizationId], references: [id])
  room              Room             @relation(fields: [roomId], references: [id])
}

model MedicalHistory {
  id          String    @id @default(uuid())
  patientId   String
  eventDate   DateTime  @default(now())
  kind        String
  details     String
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  syncedAt    DateTime?
  sourceNode  String?
  version     Int       @default(1)
  createdBy   User?     @relation("MedicalHistoryCreatedBy", fields: [createdById], references: [id])
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

/// Appointments and scheduling.
model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  requestedById   String?
  serviceUnitId   String?
  clinicId        String?
  scheduledAt     DateTime
  durationMinutes Int               @default(30)
  reason          String?
  status          AppointmentStatus @default(SCHEDULED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  syncedAt        DateTime?
  sourceNode      String?
  version         Int               @default(1)
  statusReason    String?
  cancelledAt     DateTime?
  cancelledById   String?
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedBy     User?             @relation("AppointmentRequester", fields: [requestedById], references: [id])
  serviceUnit     ServiceUnit?      @relation(fields: [serviceUnitId], references: [id])
  consultation    Consultation?     @relation("AppointmentConsultation")
  patientVisit    PatientVisit?     @relation("AppointmentPatientVisit")

  @@index([scheduledAt])
  @@index([status])
  @@index([clinicId])
}

model Hospitalization {
  id                        String                           @id @default(uuid())
  patientId                 String
  serviceUnitId             String?
  admittedAt                DateTime                         @default(now())
  dischargedAt              DateTime?
  status                    HospitalizationStatus            @default(ADMITTED)
  admissionReason           String
  dischargeReason           String?
  bedNumber                 String?
  physicianId               String?
  nurseInChargeId           String?
  syncedAt                  DateTime?
  sourceNode                String?
  version                   Int                              @default(1)
  deletedAt                 DateTime?
  bed                       Bed?                             @relation("HospitalizationBed")
  Consultation              Consultation[]
  nurseInCharge             User?                            @relation("HospitalizationNurse", fields: [nurseInChargeId], references: [id])
  patient                   Patient                          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  physician                 User?                            @relation("HospitalizationPhysician", fields: [physicianId], references: [id])
  ServiceUnit               ServiceUnit?                     @relation(fields: [serviceUnitId], references: [id])
  nurseAssignments          HospitalizationNurseAssignment[]
  nursingCareTasks          NursingCareTask[]
  medicationAdministrations MedicationAdministration[]
}

/// Vital signs recorded by nurses.
model VitalSign {
  id             String        @id @default(uuid())
  patientId      String
  recordedById   String?
  type           VitalType
  value          String
  unit           String
  recordedAt     DateTime      @default(now())
  note           String?
  consultationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  syncedAt       DateTime?
  sourceNode     String?
  version        Int           @default(1)
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy     User?         @relation("VitalSignRecordedBy", fields: [recordedById], references: [id])

  @@index([patientId, type, recordedAt])
}

/// Clinical encounters and consultations.
model Consultation {
  id                     String                   @id @default(uuid())
  patientId              String
  appointmentId          String                   @unique
  clinicId               String?
  hospitalizationId      String?
  providerId             String?
  status                 ConsultationStatus       @default(DRAFT)
  encounterType          EncounterType            @default(OUTPATIENT)
  chiefComplaint         String?
  clinicalSummary        String?
  diagnosis              String?
  assessment             String?
  plan                   String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  deletedAt              DateTime?
  syncedAt               DateTime?
  sourceNode             String?
  version                Int                      @default(1)
  appointment            Appointment              @relation("AppointmentConsultation", fields: [appointmentId], references: [id], onDelete: Cascade)
  hospitalization        Hospitalization?         @relation(fields: [hospitalizationId], references: [id])
  patient                Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider               User?                    @relation("ConsultationProvider", fields: [providerId], references: [id])
  notes                  ConsultationNote[]
  Diagnosis              Diagnosis[]
  imagingRequests        ImagingRequest[]
  InsuranceAuthorization InsuranceAuthorization[]
  labRequests            LabRequest[]
  prescriptions          Prescription[]
  surgicalPlanned        Surgery[]
  vitalSigns             VitalSign[]
  telehealthSessions     TelehealthSession[]

  @@index([patientId, status])
  @@index([providerId])
  @@index([clinicId])
}

/// Durable audit trail for a clinical video-call. Media remains WebRTC encrypted
/// between endpoints; this table stores only lifecycle and consent metadata.
model TelehealthSession {
  id                     String                  @id @default(uuid())
  consultationId         String
  doctorId               String
  patientId              String
  patientUserId          String
  status                 TelehealthSessionStatus @default(RINGING)
  expiresAt              DateTime
  initiatedAt            DateTime                @default(now())
  acceptedAt             DateTime?
  endedAt                DateTime?
  endedById              String?
  endReason              String?
  patientConsentAt       DateTime?
  transcriptionConsentAt DateTime?
  incident               String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  consultation           Consultation            @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  doctor                 User                    @relation("TelehealthSessionDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  patient                Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  patientUser            User                    @relation("TelehealthSessionPatientUser", fields: [patientUserId], references: [id], onDelete: Restrict)

  @@index([consultationId, initiatedAt])
  @@index([patientUserId, status, expiresAt])
  @@index([doctorId, status, expiresAt])
}

model ConsultationNote {
  id             String       @id @default(uuid())
  consultationId String
  authorId       String?
  noteType       String       @default("GENERAL")
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  syncedAt       DateTime?
  sourceNode     String?
  version        Int          @default(1)
  author         User?        @relation("ConsultationNoteAuthor", fields: [authorId], references: [id])
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

/// Prescriptions and pharmacy workflow.
model Prescription {
  id                String             @id @default(uuid())
  consultationId    String
  patientId         String
  prescriberId      String?
  clinicId          String?
  status            PrescriptionStatus @default(PRESCRIBED)
  prescribingDate   DateTime           @default(now())
  instruction       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  syncedAt          DateTime?
  sourceNode        String?
  version           Int                @default(1)
  pharmacyDispenses PharmacyDispense[]
  consultation      Consultation       @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriber        User?              @relation("PrescriptionPrescriber", fields: [prescriberId], references: [id])
  lineItems         PrescriptionLine[]

  @@index([patientId, status])
  @@index([clinicId])
}

model PrescriptionLine {
  id                        String                     @id @default(uuid())
  prescriptionId            String
  medicationId              String
  dosage                    String
  route                     MedicationRoute
  frequency                 MedicationFrequency
  quantity                  Int
  durationDays              Int?
  notes                     String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  syncedAt                  DateTime?
  sourceNode                String?
  version                   Int                        @default(1)
  medication                Medication                 @relation(fields: [medicationId], references: [id])
  prescription              Prescription               @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationAdministrations MedicationAdministration[]
}

model Medication {
  id                    String                 @id @default(uuid())
  code                  String                 @unique
  name                  String
  description           String?
  unit                  String
  strength              String?
  manufacturer          String?
  isControlled          Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  syncedAt              DateTime?
  sourceNode            String?
  version               Int                    @default(1)
  categoryId            String?
  GoodsReceiptLine      GoodsReceiptLine[]
  category              MedicationCategory?    @relation(fields: [categoryId], references: [id])
  pharmacyDispenseLines PharmacyDispenseLine[]
  prescriptionLines     PrescriptionLine[]
  PurchaseOrderLine     PurchaseOrderLine[]
  StockLot              StockLot[]
  StockTransaction      StockTransaction[]

  @@index([categoryId])
}

/// Explicit day/night nursing ownership for a hospitalization. Access is still gated by the live employee shift.
model HospitalizationNurseAssignment {
  id                String          @id @default(uuid())
  hospitalizationId String
  nurseId           String
  coverage          NursingCoverage
  assignedAt        DateTime        @default(now())
  releasedAt        DateTime?
  assignedById      String?
  hospitalization   Hospitalization @relation(fields: [hospitalizationId], references: [id], onDelete: Cascade)
  nurse             User            @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@unique([hospitalizationId, coverage])
  @@index([nurseId, releasedAt])
}

/// A voucher is consumed exactly once. It is separate from free-text admission metadata so reuse is prevented by a database constraint.
model ParamedicalVoucher {
  id         String   @id @default(uuid())
  number     String   @unique
  issuer     String
  serviceId  String
  patientId  String   @unique
  receivedAt DateTime @default(now())
  scanUrl    String?
  notes      String?
  createdAt  DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id])

  @@index([issuer, receivedAt])
  @@index([serviceId])
}

model NursingCareTask {
  id                 String                @id @default(uuid())
  hospitalizationId  String
  assignedNurseId    String?
  prescriptionLineId String?
  title              String
  instructions       String?
  dueAt              DateTime
  status             NursingCareTaskStatus @default(PENDING)
  completedAt        DateTime?
  completedById      String?
  escalationReason   String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  hospitalization    Hospitalization       @relation(fields: [hospitalizationId], references: [id])
  assignedNurse      User?                 @relation("NursingCareTaskAssignedNurse", fields: [assignedNurseId], references: [id])

  @@index([assignedNurseId, dueAt, status])
  @@index([hospitalizationId, dueAt])
}

model MedicationAdministration {
  id                 String                         @id @default(uuid())
  hospitalizationId  String
  prescriptionLineId String
  administeredById   String
  scheduledAt        DateTime
  administeredAt     DateTime?
  status             MedicationAdministrationStatus
  doseGiven          String?
  reason             String?
  observation        String?
  createdAt          DateTime                       @default(now())
  hospitalization    Hospitalization                @relation(fields: [hospitalizationId], references: [id])
  prescriptionLine   PrescriptionLine               @relation(fields: [prescriptionLineId], references: [id])
  administeredBy     User                           @relation("MedicationAdministrationNurse", fields: [administeredById], references: [id])

  @@index([hospitalizationId, scheduledAt])
  @@index([prescriptionLineId, scheduledAt])
}

/// Pharmacy catalogue hierarchy used by the prescription search: Section -> Category -> Medication.
model MedicationSection {
  id          String               @id @default(uuid())
  name        String
  code        String               @unique
  description String?
  active      Boolean              @default(true)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  categories  MedicationCategory[]

  @@index([active, sortOrder])
}

model MedicationCategory {
  id          String            @id @default(uuid())
  sectionId   String
  name        String
  code        String
  description String?
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  medications Medication[]
  section     MedicationSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, code])
  @@unique([sectionId, name])
  @@index([sectionId, active, sortOrder])
}

model PharmacyDispense {
  id             String                 @id @default(uuid())
  prescriptionId String
  dispensedById  String?
  dispensedAt    DateTime               @default(now())
  status         PrescriptionStatus     @default(DISPENSED)
  notes          String?
  location       String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
  syncedAt       DateTime?
  sourceNode     String?
  version        Int                    @default(1)
  clinicId       String?
  dispensedBy    User?                  @relation("PharmacyDispenseDispenser", fields: [dispensedById], references: [id])
  prescription   Prescription           @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  lines          PharmacyDispenseLine[]

  @@index([clinicId])
}

model PharmacyDispenseLine {
  id                 String           @id @default(uuid())
  pharmacyDispenseId String
  medicationId       String
  quantity           Int
  unitPrice          Decimal          @db.Decimal(12, 2)
  totalPrice         Decimal          @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  syncedAt           DateTime?
  sourceNode         String?
  version            Int              @default(1)
  medication         Medication       @relation(fields: [medicationId], references: [id])
  pharmacyDispense   PharmacyDispense @relation(fields: [pharmacyDispenseId], references: [id], onDelete: Cascade)
}

/// Laboratory workflow.
model LabRequest {
  id                String            @id @default(uuid())
  consultationId    String
  patientId         String
  requestedById     String?
  clinicId          String?
  status            LabRequestStatus  @default(REQUESTED)
  requestedAt       DateTime          @default(now())
  receivedAt        DateTime?
  performedAt       DateTime?
  completedAt       DateTime?
  sentAt            DateTime?
  accessionNumber   String?           @unique
  externalReference String?
  specimenType      String?
  priority          String?           @default("NORMAL")
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now())
  deletedAt         DateTime?
  syncedAt          DateTime?
  sourceNode        String?
  version           Int               @default(1)
  reports           LabReport[]
  consultation      Consultation      @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedBy       User?             @relation("LabRequestRequester", fields: [requestedById], references: [id])
  events            LabRequestEvent[]
  items             LabRequestItem[]
  results           LabResult[]
  samples           LabSample[]

  @@index([status])
  @@index([clinicId])
}

model LabRequestItem {
  id                String               @id @default(uuid())
  labRequestId      String
  labTestId         String
  sampleTypeId      String?
  status            LabRequestItemStatus @default(REQUESTED)
  specimenLabel     String?
  assignedToId      String?
  requestedAt       DateTime             @default(now())
  collectedAt       DateTime?
  receivedAt        DateTime?
  analysisStartedAt DateTime?
  completedAt       DateTime?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now())
  deletedAt         DateTime?
  syncedAt          DateTime?
  sourceNode        String?
  version           Int                  @default(1)
  reports           LabReport[]
  events            LabRequestEvent[]
  assignedTo        User?                @relation("LabRequestItemAssignedTo", fields: [assignedToId], references: [id])
  labRequest        LabRequest           @relation(fields: [labRequestId], references: [id], onDelete: Cascade)
  labTest           LabTest              @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  sampleType        LabSampleType?       @relation(fields: [sampleTypeId], references: [id])
  results           LabResult[]
  samples           LabSample[]

  @@index([labRequestId])
  @@index([labTestId])
  @@index([status])
}

model LabSampleType {
  id                 String                     @id @default(uuid())
  name               String                     @unique
  description        String?
  active             Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @default(now())
  requestItems       LabRequestItem[]
  samples            LabSample[]
  sampleRequirements LabTestSampleRequirement[]
}

model LabSample {
  id               String                   @id @default(uuid())
  labRequestId     String
  labRequestItemId String?
  labSampleTypeId  String
  externalId       String                   @unique
  barcode          String                   @unique
  collectedById    String?
  collectedAt      DateTime?
  volume           Decimal?                 @db.Decimal(12, 2)
  volumeUnit       String?                  @default("mL")
  condition        String?
  storageLocation  String?
  status           LabSampleStatus          @default(COLLECTED)
  receivedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @default(now())
  deletedAt        DateTime?
  syncedAt         DateTime?
  sourceNode       String?
  version          Int                      @default(1)
  collectedBy      User?                    @relation("LabSampleCollectedBy", fields: [collectedById], references: [id])
  labRequest       LabRequest               @relation(fields: [labRequestId], references: [id], onDelete: Cascade)
  labRequestItem   LabRequestItem?          @relation(fields: [labRequestItemId], references: [id])
  labSampleType    LabSampleType            @relation(fields: [labSampleTypeId], references: [id], onDelete: Cascade)
  trackingEvents   LabSampleTrackingEvent[]

  @@index([labRequestId])
  @@index([labRequestItemId])
  @@index([labSampleTypeId])
}

model LabSampleTrackingEvent {
  id            String          @id @default(uuid())
  labSampleId   String
  status        LabSampleStatus
  performedById String?
  note          String?
  createdAt     DateTime        @default(now())
  labSample     LabSample       @relation(fields: [labSampleId], references: [id], onDelete: Cascade)
  performedBy   User?           @relation("LabSampleTrackingPerformedBy", fields: [performedById], references: [id])

  @@index([labSampleId])
}

model LabRequestEvent {
  id               String          @id @default(uuid())
  labRequestId     String
  labRequestItemId String?
  action           String
  fromStatus       String?
  toStatus         String?
  performedById    String?
  note             String?
  createdAt        DateTime        @default(now())
  labRequest       LabRequest      @relation(fields: [labRequestId], references: [id], onDelete: Cascade)
  labRequestItem   LabRequestItem? @relation(fields: [labRequestItemId], references: [id])
  performedBy      User?           @relation("LabRequestEventPerformedBy", fields: [performedById], references: [id])

  @@index([labRequestId])
  @@index([labRequestItemId])
}

model LabResult {
  id                      String                    @id @default(uuid())
  labRequestId            String
  labRequestItemId        String?
  resultCode              String
  resultName              String
  resultType              LabResultType             @default(MULTI_PARAMETER)
  resultStatus            LabResultValidationStatus @default(PENDING)
  resultValue             String?
  numericValue            Decimal?                  @db.Decimal(12, 4)
  textValue               String?
  units                   String?
  referenceRange          String?
  interpretation          String?
  reportedById            String?
  technicalValidatedById  String?
  biologicalValidatedById String?
  reportedAt              DateTime                  @default(now())
  technicalValidationAt   DateTime?
  biologicalValidationAt  DateTime?
  comments                String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now())
  deletedAt               DateTime?
  syncedAt                DateTime?
  sourceNode              String?
  version                 Int                       @default(1)
  criticalAlerts          LabCriticalAlert[]
  biologicalValidatedBy   User?                     @relation("LabResultBiologicalValidator", fields: [biologicalValidatedById], references: [id])
  labRequest              LabRequest                @relation(fields: [labRequestId], references: [id], onDelete: Cascade)
  labRequestItem          LabRequestItem?           @relation(fields: [labRequestItemId], references: [id], onDelete: Cascade)
  reportedBy              User?                     @relation("LabResultReporter", fields: [reportedById], references: [id])
  technicalValidatedBy    User?                     @relation("LabResultTechnicalValidator", fields: [technicalValidatedById], references: [id])
  parameters              LabResultParameter[]

  @@index([resultCode])
  @@index([labRequestItemId])
}

model LabResultParameter {
  id                 String             @id @default(uuid())
  labResultId        String
  labTestParameterId String?
  valueNumeric       Decimal?           @db.Decimal(12, 4)
  valueText          String?
  interpretation     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now())
  method             String?
  parameterCode      String?
  parameterName      String?
  referenceRange     String?
  reportedAt         DateTime           @default(now())
  reportedById       String?
  unit               String?
  validatedAt        DateTime?
  validationNote     String?
  criticalAlerts     LabCriticalAlert[]
  labResult          LabResult          @relation(fields: [labResultId], references: [id], onDelete: Cascade)
  labTestParameter   LabTestParameter?  @relation(fields: [labTestParameterId], references: [id])
  reportedBy         User?              @relation("LabResultParameterReporter", fields: [reportedById], references: [id])

  @@index([labResultId])
  @@index([labTestParameterId])
}

model LabSection {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  active      Boolean           @default(true)
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now())
  categories  LabCategory[]
  staff       LabSectionStaff[]
  tests       LabTest[]
}

model LabCategory {
  id          String      @id @default(uuid())
  sectionId   String?
  name        String
  code        String?     @unique
  description String?
  active      Boolean     @default(true)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())
  section     LabSection? @relation(fields: [sectionId], references: [id])
  tests       LabTest[]

  @@unique([sectionId, name])
}

model LabTest {
  id                     String                         @id @default(uuid())
  code                   String                         @unique
  name                   String
  categoryId             String
  sectionId              String?
  description            String?
  price                  Decimal                        @db.Decimal(12, 2)
  turnaroundTimeMinutes  Int?
  resultType             LabResultType                  @default(MULTI_PARAMETER)
  unit                   String?
  referenceRange         String?
  genderRestriction      GenderRestriction              @default(ALL)
  minAge                 Int?
  maxAge                 Int?
  active                 Boolean                        @default(true)
  createdById            String?
  updatedById            String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @default(now())
  requestItems           LabRequestItem[]
  category               LabCategory                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy              User?                          @relation("LabTestCreatedBy", fields: [createdById], references: [id])
  section                LabSection?                    @relation(fields: [sectionId], references: [id])
  updatedBy              User?                          @relation("LabTestUpdatedBy", fields: [updatedById], references: [id])
  consumableRequirements LabTestConsumableRequirement[]
  parameterTemplates     LabTestParameter[]
  sampleRequirements     LabTestSampleRequirement[]

  @@index([categoryId])
}

model LabTestParameter {
  id               String               @id @default(uuid())
  labTestId        String
  code             String
  name             String
  unit             String?
  resultType       LabResultType        @default(NUMERIC)
  referenceRange   String?
  minValue         Decimal?             @db.Decimal(12, 4)
  maxValue         Decimal?             @db.Decimal(12, 4)
  active           Boolean              @default(true)
  order            Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now())
  archivedAt       DateTime?
  criticalHigh     Decimal?             @db.Decimal(12, 4)
  criticalLow      Decimal?             @db.Decimal(12, 4)
  method           String?
  resultParameters LabResultParameter[]
  labTest          LabTest              @relation(fields: [labTestId], references: [id], onDelete: Cascade)

  @@index([labTestId])
}

model LabTestSampleRequirement {
  id               String        @id @default(uuid())
  labTestId        String
  labSampleTypeId  String
  volumeRequired   Decimal?      @db.Decimal(12, 2)
  volumeUnit       String?       @default("mL")
  storageCondition String?
  maxAgeMinutes    Int?
  instructions     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now())
  archivedAt       DateTime?
  labSampleType    LabSampleType @relation(fields: [labSampleTypeId], references: [id], onDelete: Cascade)
  labTest          LabTest       @relation(fields: [labTestId], references: [id], onDelete: Cascade)

  @@index([labTestId])
  @@index([labSampleTypeId])
}

model LabConsumable {
  id           String                         @id @default(uuid())
  name         String
  code         String                         @unique
  description  String?
  unit         String
  active       Boolean                        @default(true)
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @default(now())
  stock        LabConsumableStock[]
  transactions LabConsumableTransaction[]
  requirements LabTestConsumableRequirement[]
}

model LabTestConsumableRequirement {
  id              String        @id @default(uuid())
  labTestId       String
  labConsumableId String
  quantity        Decimal       @db.Decimal(12, 2)
  unit            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
  archivedAt      DateTime?
