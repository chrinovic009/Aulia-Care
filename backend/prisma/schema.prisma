  labResultId          String
  labResultParameterId String?
  severity             LabCriticalAlertSeverity @default(CRITICAL)
  status               LabCriticalAlertStatus   @default(PENDING)
  message              String
  detectedAt           DateTime                 @default(now())
  acknowledgedAt       DateTime?
  acknowledgedById     String?
  acknowledgementNote  String?
  resolvedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  acknowledgedBy       User?                    @relation("LabCriticalAlertAcknowledger", fields: [acknowledgedById], references: [id])
  labResult            LabResult                @relation(fields: [labResultId], references: [id], onDelete: Cascade)
  labResultParameter   LabResultParameter?      @relation(fields: [labResultParameterId], references: [id])
  patient              Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status, detectedAt])
  @@index([labResultId])
}

