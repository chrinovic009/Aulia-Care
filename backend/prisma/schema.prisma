  decision        ClaimDecision?
  rejectionReason String?
  submittedAt     DateTime?
  decidedAt       DateTime?
  processedById   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  invoice         Invoice?        @relation(fields: [invoiceId], references: [id])
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  policy          InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  processedBy     User?           @relation(fields: [processedById], references: [id])

  @@index([policyId])
  @@index([patientId])
}

model InsuranceAuthorization {
  id             String              @id @default(uuid())
  policyId       String
  patientId      String
  consultationId String?
  serviceId      String?
  status         AuthorizationStatus @default(REQUESTED)
  requestedAt    DateTime            @default(now())
  authorizedAt   DateTime?
  authorizedById String?
  expiresAt      DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  authorizedBy   User?               @relation(fields: [authorizedById], references: [id])
  consultation   Consultation?       @relation(fields: [consultationId], references: [id])
  patient        Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  policy         InsurancePolicy     @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

/// == Pharmacie avancée (achats, lots, valorisation) ==
model SubscriptionCompany {
  id                 String                       @id @default(uuid())
  name               String
  legalName          String?
  registrationNumber String?
  taxNumber          String?
  address            String?
  phone              String?
  email              String?
  contactName        String?
  contactPhone       String?
  contactEmail       String?
  contractNumber     String?                      @unique
  status             SubscriptionCompanyStatus    @default(ACTIVE)
  billingDay         Int                          @default(30)
  creditLimit        Decimal?                     @db.Decimal(12, 2)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  deletedAt          DateTime?
  monthlyInvoices    MonthlySubscriptionInvoice[]
  charges            SubscriptionCharge[]
  employees          SubscriptionEmployee[]

  @@index([name])
  @@index([status])
}

model SubscriptionEmployee {
  id               String                     @id @default(uuid())
  companyId        String
  patientId        String?
  firstName        String
  lastName         String
  middleName       String?
  gender           String?
  profession       String?
  dateOfBirth      DateTime?
  age              Int?
  phone            String?
  email            String?
  address          String?
  nationality      String?
  policyNumber     String
  employeeNumber   String?
  status           SubscriptionEmployeeStatus @default(ACTIVE)
  firstAdmissionAt DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  deletedAt        DateTime?
  charges          SubscriptionCharge[]
  company          SubscriptionCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient          Patient?                   @relation(fields: [patientId], references: [id])

  @@unique([companyId, policyNumber])
  @@index([patientId])
  @@index([companyId, status])
}

model SubscriptionCharge {
  id          String                   @id @default(uuid())
  companyId   String
  employeeId  String?
  patientId   String?
  invoiceId   String?
  serviceId   String?
  label       String
  amount      Decimal                  @db.Decimal(12, 2)
  currency    String                   @default("CDF")
  serviceDate DateTime                 @default(now())
  month       Int
  year        Int
  status      SubscriptionChargeStatus @default(PENDING_MONTHLY_INVOICE)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  deletedAt   DateTime?
  company     SubscriptionCompany      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    SubscriptionEmployee?    @relation(fields: [employeeId], references: [id])
  invoice     Invoice?                 @relation(fields: [invoiceId], references: [id])
  patient     Patient?                 @relation(fields: [patientId], references: [id])
  service     Service?                 @relation(fields: [serviceId], references: [id])

  @@index([companyId, year, month])
  @@index([patientId])
  @@index([status])
}

model MonthlySubscriptionInvoice {
  id          String                           @id @default(uuid())
  companyId   String
  invoiceId   String?
  month       Int
  year        Int
  totalAmount Decimal                          @db.Decimal(12, 2)
  status      MonthlySubscriptionInvoiceStatus @default(DRAFT)
  generatedAt DateTime                         @default(now())
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt
  deletedAt   DateTime?
  company     SubscriptionCompany              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice     Invoice?                         @relation(fields: [invoiceId], references: [id])

  @@unique([companyId, year, month])
  @@index([status])
}

model Pharmacy {
  id        String            @id @default(uuid())
  clinicId  String?
  name      String
  location  String?
  phone     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  stocks    MedicationStock[]
  clinic    Clinic?           @relation(fields: [clinicId], references: [id])
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  supplierId      String
  clinicId        String?
  orderNumber     String              @unique
  status          PurchaseOrderStatus @default(DRAFT)
  orderedById     String?
  orderedAt       DateTime            @default(now())
  expectedAt      DateTime?
  totalAmount     Decimal?            @db.Decimal(12, 2)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  goodsReceipts   GoodsReceipt[]
  clinic          Clinic?             @relation(fields: [clinicId], references: [id])
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  lines           PurchaseOrderLine[]
  SupplierInvoice SupplierInvoice[]

  @@index([supplierId])
  @@index([clinicId])
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  medicationId    String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  totalPrice      Decimal       @db.Decimal(12, 2)
  currency        String?       @default("CDF")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  medication      Medication    @relation(fields: [medicationId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([medicationId])
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  purchaseOrderId String?
  supplierId      String?
  receivedAt      DateTime           @default(now())
  receivedById    String?
  status          GoodsReceiptStatus @default(RECEIVED)
  notes           String?
  createdAt       DateTime           @default(now())
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  receivedBy      User?              @relation(fields: [receivedById], references: [id])
  supplier        Supplier?          @relation(fields: [supplierId], references: [id])
  lines           GoodsReceiptLine[]

  @@index([purchaseOrderId])
}

model GoodsReceiptLine {
  id             String       @id @default(uuid())
  goodsReceiptId String
  medicationId   String
  quantity       Int
  unitPrice      Decimal      @db.Decimal(12, 2)
  batchNumber    String?
  expiryDate     DateTime?
  createdAt      DateTime     @default(now())
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  medication     Medication   @relation(fields: [medicationId], references: [id])

  @@index([goodsReceiptId])
  @@index([medicationId])
}

model SupplierInvoice {
  id                    String                @id @default(uuid())
  supplierId            String
  supplierInvoiceNumber String?
  purchaseOrderId       String?
  amount                Decimal               @db.Decimal(12, 2)
  status                SupplierInvoiceStatus @default(DRAFT)
  issuedAt              DateTime?
  dueDate               DateTime?
  createdAt             DateTime              @default(now())
  purchaseOrder         PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  supplier              Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  SupplierPayment       SupplierPayment[]

  @@index([supplierId])
}

model SupplierPayment {
  id                String           @id @default(uuid())
  supplierId        String
  supplierInvoiceId String?
  amount            Decimal          @db.Decimal(12, 2)
  paidAt            DateTime         @default(now())
  method            String?
  reference         String?
  createdAt         DateTime         @default(now())
  supplier          Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierInvoice   SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id])

  @@index([supplierId])
}

/// Stock lot tracking and valuation
model StockLot {
  id               String             @id @default(uuid())
  medicationId     String
  clinicId         String?
  batchNumber      String
  quantity         Int
  purchasePrice    Decimal?           @db.Decimal(12, 2)
  expiryDate       DateTime?
  receivedAt       DateTime           @default(now())
  createdAt        DateTime           @default(now())
  clinic           Clinic?            @relation(fields: [clinicId], references: [id])
  medication       Medication         @relation(fields: [medicationId], references: [id])
  StockTransaction StockTransaction[]

  @@index([medicationId])
  @@index([batchNumber])
  @@index([clinicId])
}

model StockTransaction {
  id            String     @id @default(uuid())
  medicationId  String
  lotId         String?
  type          String
  quantity      Int
  unitPrice     Decimal?   @db.Decimal(12, 2)
  reference     String?
  performedById String?
  clinicId      String?
  createdAt     DateTime   @default(now())
  clinic        Clinic?    @relation(fields: [clinicId], references: [id])
  lot           StockLot?  @relation(fields: [lotId], references: [id])
  medication    Medication @relation(fields: [medicationId], references: [id])
  performedBy   User?      @relation(fields: [performedById], references: [id])

  @@index([medicationId, createdAt])
}

model Employee {
  id               String               @id @default(uuid())
  userId           String?
  clinicId         String?
  employeeNumber   String?              @unique
  firstName        String
  lastName         String
  gender           String?
  dateOfBirth      DateTime?
  hireDate         DateTime?
  terminationDate  DateTime?
  status           EmployeeStatus       @default(ACTIVE)
  position         String?
  departmentId     String?
  serviceUnitId    String?
  shiftPattern     EmployeeShiftPattern @default(MANUAL)
  rotationAnchorAt DateTime?
  /// Number of consecutive day shifts, followed by the same number of night shifts and rest days.
  rotationDays     Int                  @default(3)
  /// End of the permanent day shift in local hospital time (HH:mm). Start is always 07:30.
  permanentShiftEndTime String?         @default("17:30")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  attendances      Attendance[]
  clinic           Clinic?              @relation(fields: [clinicId], references: [id])
  department       Department?          @relation(fields: [departmentId], references: [id])
  serviceUnit      ServiceUnit?         @relation(fields: [serviceUnitId], references: [id])
  user             User?                @relation(fields: [userId], references: [id])
  contracts        EmployeeContract[]
  leaveRequests    LeaveRequest[]
  payrolls         Payroll[]
  shifts           Shift[]

  @@index([userId])
  @@index([clinicId])
}

model EmployeeContract {
  id         String       @id @default(uuid())
  employeeId String
  type       ContractType @default(PERMANENT)
  startDate  DateTime
  endDate    DateTime?
  salary     Decimal?     @db.Decimal(12, 2)
  currency   String?      @default("CDF")
  frequency  String?
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Shift {
  id         String       @id @default(uuid())
  employeeId String
  startAt    DateTime
  endAt      DateTime
  type       ShiftType
  createdAt  DateTime     @default(now())
  Attendance Attendance[]
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startAt])
}

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  shiftId    String?
  clockInAt  DateTime?
  clockOutAt DateTime?
  status     AttendanceStatus @default(PRESENT)
  createdAt  DateTime         @default(now())
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift      Shift?           @relation(fields: [shiftId], references: [id])

  @@index([employeeId])
}

model LeaveRequest {
  id          String      @id @default(uuid())
  employeeId  String
  leaveType   String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      LeaveStatus @default(PENDING)
  requestedAt DateTime    @default(now())
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?       @relation(fields: [decidedById], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
}

model Payroll {
  id            String        @id @default(uuid())
  employeeId    String
  periodStart   DateTime
  periodEnd     DateTime
  grossAmount   Decimal       @db.Decimal(12, 2)
  netAmount     Decimal       @db.Decimal(12, 2)
  taxes         Json?
  deductions    Json?
  status        PayrollStatus @default(DRAFT)
  processedAt   DateTime?
  processedById String?
  createdAt     DateTime      @default(now())
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  processedBy   User?         @relation(fields: [processedById], references: [id])

  @@index([employeeId, status])
}

/// == Audit et sécurité ==
model AuditTrail {
  id        String      @id @default(uuid())
  actorId   String?
  entity    String
  entityId  String
  action    AuditAction
  before    Json?
  after     Json?
  changedAt DateTime    @default(now())
  actor     User?       @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  changedAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id         String      @id @default(uuid())
  userId     String?
  username   String?
  result     LoginResult @default(FAILURE)
  ipAddress  String?
  userAgent  String?
  occurredAt DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Session {
  id         String        @id @default(uuid())
  userId     String
  tokenHash  String
  ipAddress  String?
  userAgent  String?
  lastSeenAt DateTime?
  expiresAt  DateTime?
  status     SessionStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// == Sécurité supplémentaire ==
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

