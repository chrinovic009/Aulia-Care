FROM node:22-bookworm-slim

WORKDIR /app

# Prisma nécessite OpenSSL dans l'environnement Linux.
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/package.json
COPY backend/package.json ./backend/package.json

RUN npm ci

COPY backend ./backend

WORKDIR /app/backend

RUN npx prisma generate --schema prisma/schema.prisma

EXPOSE 3000

# A fresh Docker volume has no application tables. Generate from the mounted
# schema and apply the additive Prisma migration history before Nest accepts
# requests; otherwise the first login can fail with P2021 (table User missing).
#
# Nodemon's legacy watcher is not stable on this Windows bind mount: it can
# restart Nest repeatedly without a source change, causing transient 500s
# through Vite's proxy. Docker therefore runs one stable TypeScript process;
# recreate `backend` after a source edit during local development.
CMD ["sh", "-c", "npx prisma generate --schema prisma/schema.prisma && npx prisma migrate deploy --schema prisma/schema.prisma && npx ts-node --transpile-only --project tsconfig.json src/main.ts"]
