# Copy to backend/.env locally. Never commit the resulting file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
PORT=3000
NODE_ENV=development
# Generate distinct high-entropy values in a secret manager.
JWT_SECRET="AuliaCareChris1501&qjelbfouhvbgougfvoyuvcqdiyfgqdcoiyfvgqicdfvyfdSGHUY0+0ZI9O09UZ°90Y70UPIJHIUGHBKIFVCIYFVOYUFCIYTFYIF"
JWT_REFRESH_SECRET="AuliaCareChris1501&qjelbfouhvbgougfvoyuvcqdiyfgqdcoiyfvgqicdfvyfdSGHUY0+0ZI9O09UZ°90Y70UPIJHIUGHBKIFVCIYFVOYUFCIYTFYIF"
JWT_ACCESS_EXPIRES_IN="20m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
# Required when several backend instances are running behind a load balancer.
# Use a private, password-protected Redis instance; never expose it publicly.
REDIS_URL="redis://:PASSWORD@127.0.0.1:6379/0"
