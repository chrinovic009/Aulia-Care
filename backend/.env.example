# Copy to backend/.env locally. Never commit the resulting file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
PORT=3000
NODE_ENV=development
# Public Core demonstration only. Keep this disabled for normal installations.
# AULIA_APP_MODE=demo
# AULIA_DEMO_SEED_CONFIRM=true
# AULIA_DEMO_PASSWORD=SET_OUTSIDE_SOURCE_CONTROL
# AULIA_DEMO_DATABASE_NAME=SET_TO_THE_EXACT_ISOLATED_DEMO_DATABASE_NAME
# AULIA_DEMO_DATABASE_USER=SET_TO_THE_DEDICATED_DEMO_POSTGRES_USER
# AULIA_DEMO_DATABASE_SENTINEL=SET_TO_A_HIGH_ENTROPY_DATABASE_RESIDENT_SENTINEL
# AULIA_ENABLE_DIAGNOSTIC_AGENT=false
# AULIA_ENABLE_CONNECTED_CARE=false
# Generate distinct high-entropy values in a secret manager.
JWT_SECRET="CHANGE_ME_WITH_A_STRONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_WITH_A_DIFFERENT_STRONG_RANDOM_SECRET"
JWT_ACCESS_EXPIRES_IN="20m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173"
# Required when several backend instances are running behind a load balancer.
# Use a private, password-protected Redis instance; never expose it publicly.
REDIS_URL="redis://:PASSWORD@127.0.0.1:6379/0"
