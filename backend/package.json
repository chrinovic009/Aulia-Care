{
  "name": "@aulia-care/backend",
  "version": "3.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --transpile-only --project tsconfig.json --respawn src/main.ts",
    "dev:clinical-ai": "ts-node-dev --transpile-only --project tsconfig.json --respawn src/main-clinical-ai.ts",
    "dev:connected-care": "ts-node-dev --transpile-only --project tsconfig.json --respawn src/main-connected-care.ts",

    "build": "tsc -p tsconfig.build.json",

    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:clinical-ai": "node dist/main-clinical-ai.js",
    "start:connected-care": "node dist/main-connected-care.js",

    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",

    "test": "npm run test:unit",
    "test:unit": "tsx --test src/**/*.test.ts",
    "test:integration": "tsx --test test/integration/**/*.test.ts",
    "test:e2e": "tsx --tsconfig tsconfig.json --test test/e2e/**/*.test.ts",

    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "prisma db seed --schema prisma/schema.prisma",

    "bootstrap:dev": "ts-node --transpile-only --project tsconfig.json src/scripts/bootstrap-dev.ts",

    "maintenance:backfill-single-clinic-staff": "ts-node --transpile-only --project tsconfig.json src/scripts/backfill-single-clinic-staff.ts",
    "maintenance:security-retention": "ts-node --transpile-only --project tsconfig.json src/scripts/purge-security-retention.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.3",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.27",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "dotenv": "^16.3.1",
    "helmet": "^8.3.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^25.9.1",
    "@types/passport-jwt": "^3.0.8",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.19.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}