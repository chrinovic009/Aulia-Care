# Template only — never use these placeholder values in production.
# Store real values in the institution's approved secret manager, then inject
# them into the deployment environment. Do not commit a populated copy.

POSTGRES_USER=aulia
POSTGRES_PASSWORD=REPLACE_WITH_A_NEW_64_CHARACTER_SECRET
POSTGRES_DB=aulia_care
REDIS_PASSWORD=REPLACE_WITH_A_NEW_64_CHARACTER_SECRET

# Use the internal Docker DNS names. Values must contain the real password.
DATABASE_URL=postgresql://aulia:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/aulia_care?schema=public
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0

# Exact stable DNS origin; no localhost, IP address, or trailing slash.
CORS_ORIGIN=https://care.example-hospital.local
PORT=3000

JWT_SECRET=REPLACE_WITH_A_NEW_64_CHARACTER_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_NEW_64_CHARACTER_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AULIA_ENABLE_CLINICAL_AI=true
AULIA_ENABLE_CONNECTED_CARE=true
CLINICAL_AI_PORT=3100
AULIA_CLINICAL_AI_URL=http://clinical-ai:3100
CLINICAL_AI_SERVICE_SECRET=REPLACE_WITH_A_NEW_64_CHARACTER_SECRET
CONNECTED_CARE_PORT=3200
AULIA_CORE_CONNECTED_CARE_URL=http://backend:3000/api
CONNECTED_CARE_INGESTION_SECRET=REPLACE_WITH_A_NEW_64_CHARACTER_SECRET
CONNECTED_CARE_GATEWAY_SECRET=REPLACE_WITH_A_NEW_64_CHARACTER_SECRET

# Add the following variables only for the single offline initial DEV
# bootstrap. Remove them immediately after the script succeeds.
# AULIA_INITIAL_DEV_BOOTSTRAP_ENABLED=true
# AULIA_INITIAL_DEV_BOOTSTRAP_CONFIRM=CREATE_INITIAL_PLATFORM_DEV
# AULIA_INITIAL_DEV_BOOTSTRAP_EMAIL=platform-admin@example-hospital.local
# AULIA_INITIAL_DEV_BOOTSTRAP_USERNAME=platform-dev
# AULIA_INITIAL_DEV_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# AULIA_INITIAL_DEV_BOOTSTRAP_TOKEN=REPLACE_WITH_ONE_TIME_TOKEN
# AULIA_INITIAL_DEV_BOOTSTRAP_TOKEN_HASH=REPLACE_WITH_BCRYPT_HASH_OF_TOKEN
